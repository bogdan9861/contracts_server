generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  ACTIVE
  NEW
  CLOSED
}

enum ContractStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum AuditType {
  CONTRACT_CREATED
  CLIENT_CREATED
  STATUS_CHANGED
  CLIENT_UPDATED
  CONTRACT_UPDATED
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  fullName    String
  companyName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contracts Contract[]
  clients   Client[]
  auditLogs AuditLog[]
}

model Contract {
  id      String         @id @default(uuid())
  status  ContractStatus @default(ACTIVE)
  number  String
  date    DateTime
  sum     String
  fileUrl String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?
}

model Client {
  id            String       @id @default(uuid())
  companyName   String?
  contactPerson String
  email         String
  phone         String
  status        ClientStatus @default(NEW)
  createDate    DateTime     @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  contracts Contract[]
}

model AuditLog {
  id      String    @id @default(uuid())
  type    AuditType
  message String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}
